# Portfolio OS - Environment Variables
# Copy this file to .env and fill in your values

# Host port for the frontend container
FRONTEND_PORT=80

# SMTP Configuration (for Gmail, use App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email where contact form messages will be sent
CONTACT_EMAIL=you@example.com

# Network app: services to monitor, as Name|URL pairs separated by commas
STATUS_SERVICES=Website|https://example.com
# Name shown for the server that runs the backend
STATUS_HOST_LABEL=Home server

# Projects.exe: follow the repositories pinned on your GitHub profile.
# GITHUB_TOKEN is a fine-grained token with read-only access to public data.
# Leave both empty to use the `featured` flags from js/config.js.
GITHUB_USER=
GITHUB_TOKEN=

# Cloudflare Turnstile secret key for the contact form (optional, see README).
# The public site key goes in js/config.js (turnstileSiteKey).
TURNSTILE_SECRET=

# CORS origin (use your domain in production)
CORS_ORIGIN=*
